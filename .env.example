# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# From https://resend.com/api-keys (free tier: 100 emails/day, 3000/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you've verified in Resend, OR
# onboarding@resend.dev for testing (Resend's own sandbox sender — works
# immediately, no domain verification needed, fine for personal use).
ALERT_FROM=onboarding@resend.dev

# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# From your Supabase project: Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The service_role key (NOT the anon key) — this bypasses row-level
# security so the checker can read every user's watchers. Keep it out
# of the website entirely; it only belongs here and in GitHub secrets.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# From https://resend.com/api-keys (free tier: 100 emails/day, 3000/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you've verified in Resend, OR
# onboarding@resend.dev for testing (only delivers to your own Resend
# account email until you verify a domain).
ALERT_FROM=onboarding@resend.dev
